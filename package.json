{
  "name": "dsh-active-sessions",
  "version": "0.1.1",
  "description": "Active sessions bell for DeepSeek Harness with running task indicators and recent session filters",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "test": "node --test test/verify.mjs",
    "publish:github": "node tools/publish-to-github.mjs"
  },
  "author": "QIN-SMART",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEVbyQIN/dsh-active-sessions.git"
  },
  "homepage": "https://github.com/DEVbyQIN/dsh-active-sessions#readme",
  "bugs": {
    "url": "https://github.com/DEVbyQIN/dsh-active-sessions/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "active-sessions",
    "running-sessions",
    "workspace-header"
  ],
  "license": "MIT"
}
